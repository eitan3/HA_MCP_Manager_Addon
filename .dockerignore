# Keep host build output out of the image.
#
# The Dockerfile installs dependencies with `npm ci` and then copies the source
# tree over it. Without these rules a node_modules/ or dist/ left behind by a
# local build would be copied in on top of that install, replacing the pinned
# dependency tree with whatever was resolved on the host (and, for native
# modules, with binaries built for the wrong platform).
node_modules/
webui/node_modules/
dist/
webui/dist/

# Version control and editor state
.git/
.gitignore
.vscode/
.idea/

# Docs and local tooling - not needed to build the image
*.md
.claude/
.env
.env.*
npm-debug.log*
