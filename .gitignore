# ============================================
# MCP Manager Addon - Git Ignore File
# ============================================

# ============================================
# Dependencies
# ============================================

# Node.js dependencies (backend)
node_modules/

# Node.js dependencies (frontend)
webui/node_modules/

# Package lock files are intentionally committed and must NOT be ignored.
# The Docker build installs with `npm ci`, which requires them; without the
# lock files every addon rebuild re-resolves dependencies and can pick up a
# breaking release that was published since the last build.

# ============================================
# Build Output
# ============================================

# Backend compiled TypeScript
dist/

# Frontend build output
webui/dist/

# TypeScript cache
*.tsbuildinfo

# ============================================
# Environment & Secrets
# ============================================

# Environment files
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# Secret files
*.pem
*.key
secrets/
.secrets

# ============================================
# Logs
# ============================================

# Log files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ============================================
# Testing & Coverage
# ============================================

# Test coverage
coverage/
.nyc_output/

# Jest
*.lcov

# ============================================
# IDE & Editors
# ============================================

# Visual Studio Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo
*.swn
*~

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================
# Operating System
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ============================================
# Docker
# ============================================

# Docker compose override (local dev)
docker-compose.override.yml
docker-compose.local.yml

# ============================================
# Home Assistant Addon Specific
# ============================================

# Local addon data (runtime)
data/

# Runtime configuration backups
*.bak
*.backup
*.old

# Local testing configuration
/config/
!config.yaml

# ============================================
# Miscellaneous
# ============================================

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Cache directories
.cache/
.parcel-cache/

# Kilo code
.kilocode/

# Debug files
*.debug

# Compressed files (usually not needed in repo)
*.zip
*.tar.gz
*.tgz
*.rar

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Vite cache
webui/.vite/

# Yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
